# edenserver.service — systemd unit for the standalone Eden world-backend server.
#
# Install:   cp ops/edenserver.service /etc/systemd/system/edenserver.service
#            (edit the paths / args below to match your box, then:)
#            systemctl daemon-reload && systemctl enable --now edenserver
#
# See ops/INSTALL.md for the full runbook (creating the user, firewall, backups,
# verifying the exit criteria).
#
# ---------------------------------------------------------------------------
# Logging / std::unitbuf
#   edenserver calls `std::cout << std::unitbuf` at startup so every log line is
#   flushed immediately instead of sitting in a block buffer until the process
#   exits. That is what makes `journalctl -u edenserver -f` show live output.
#   To keep it working: run the binary DIRECTLY (as ExecStart does below). Do not
#   wrap it in a shell pipeline, `stdbuf`, `tee`, or anything that re-buffers its
#   stdout — that would defeat the unitbuf and logs would only appear in chunks.
#   StandardOutput=journal already gives journald the raw stream.
#
# ---------------------------------------------------------------------------
# Configuration — EnvironmentFile, and the ${VAR} vs $VAR split
#   Every setting is an environment variable in /etc/edenserver.conf (copy it
#   from ops/edenserver.conf.example). `EnvironmentFile=-/etc/edenserver.conf`
#   (leading `-`) means a missing file is not a startup failure, so this template
#   still works before anyone adopts the conf file — but ExecStart then expands
#   the required keys to empty and the server exits with a flag error in the
#   journal. Create the file.
#
#   ExecStart below uses BRACED ${VAR} for the five always-set keys (one argument
#   each, spaces preserved) and BARE $EDEN_EXTRA_ARGS once, for a whitespace-split
#   tail of optional spaceless flags. An unset braced ${VAR} still passes an
#   empty argument, so anything optional-and-possibly-spaced must live in
#   EDEN_EXTRA_ARGS, never as its own ${VAR}. The conf file header explains this
#   at length; do not "tidy" ExecStart by turning EDEN_EXTRA_ARGS into ${...}.
#
# ---------------------------------------------------------------------------
# Restart policy — why NOT Restart=always
#   --idle-timeout makes the server exit(0) *cleanly* once it has had no players
#   for N seconds (for on-demand / matchmaker-spawned worlds). systemd's
#   Restart=always restarts a unit on ANY exit, clean or not — so pairing it with
#   --idle-timeout produces a restart loop: start, sit idle, exit(0), restart,
#   sit idle, exit(0)... forever, hammering the CPU and the journal.
#   Restart=on-failure only restarts on a non-zero exit / signal, so a crash is
#   recovered but a deliberate idle exit is respected. This unit does not pass
#   --idle-timeout (an always-on server wants to stay up); if you add it, keep
#   Restart=on-failure. If you switch to Restart=always, remove --idle-timeout.
# ---------------------------------------------------------------------------

[Unit]
Description=Eden world-backend server
Documentation=https://github.com/hagg3/ewb-server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# Dedicated unprivileged user — see ops/INSTALL.md for `useradd`.
User=edenserver
Group=edenserver

# The state root. Every world file is addressed absolutely off ${EDEN_WORLD_DIR}
# in ExecStart, so CWD is only a fallback; it must still be a directory the
# service user can reach.
WorkingDirectory=/var/lib/edenserver

# All settings come from /etc/edenserver.conf. `-` => a missing file is tolerated
# (the server then errors on the empty flags, visibly, in the journal).
EnvironmentFile=-/etc/edenserver.conf

# Braced ${VAR} for the always-set keys; bare $EDEN_EXTRA_ARGS for the optional
# spaceless tail. Edit /etc/edenserver.conf, not this line. See the conf header
# and the note block above for why the split matters.
ExecStart=/usr/local/bin/edenserver --port ${EDEN_PORT} --name ${EDEN_NAME} --world ${EDEN_WORLD_DIR}/eden_world.model --signs ${EDEN_WORLD_DIR}/eden_signs.txt --spawn-file ${EDEN_WORLD_DIR}/eden_spawn.txt --ban-file ${EDEN_WORLD_DIR}/eden_bans.txt --ops-file ${EDEN_WORLD_DIR}/eden_ops.txt --control-socket ${EDEN_WORLD_DIR}/edenserver.sock --max-world-cells ${EDEN_MAX_WORLD_CELLS} --password ${EDEN_PASSWORD} $EDEN_EXTRA_ARGS

Restart=on-failure
RestartSec=2s

# Give a graceful stop room to finish. The server has no SIGTERM handler yet
# (roadmap plan §5.4), so `systemctl stop` still loses up to one autosave
# interval; edenadmin stops it through `edenctl stop` instead. When the handler
# lands, this is the window it saves in.
TimeoutStopSec=20

# Live logs to the journal: journalctl -u edenserver -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=edenserver

# --- Sandboxing (defence in depth; the server is network-facing) ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# The only path the service may write to:
ReadWritePaths=/var/lib/edenserver
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
