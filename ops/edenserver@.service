# edenserver@.service — systemd template unit for multi-world Eden world-backend server.
#
# This is a template unit that allows multiple independent edenserver instances,
# each identified by an instance name (e.g. "myworld"), to run on the same machine.
#
# Install:   1. Create per-instance config files in /etc/eden/instances/ (see below)
#               mkdir -p /etc/eden/instances
#               cp ops/edenserver.conf.example /etc/eden/instances/<name>.conf
#               sudoedit /etc/eden/instances/<name>.conf
#            2. Create the world directories:
#               mkdir -p /var/lib/edenserver/worlds/<name>
#               chown edenserver:edenserver /var/lib/edenserver/worlds/<name>
#            3. Enable and start the instance:
#               systemctl daemon-reload
#               systemctl enable --now edenserver@<name>
#
# See ops/INSTALL.md for the full runbook and ops/INSTALL.md § Multi-world for
# instance-specific setup, verification, and edenserverctl usage.
#
# ---------------------------------------------------------------------------
# Logging / std::unitbuf
#   edenserver calls `std::cout << std::unitbuf` at startup so every log line is
#   flushed immediately instead of sitting in a block buffer until the process
#   exits. That is what makes `journalctl -u edenserver@<name> -f` show live output.
#   To keep it working: run the binary DIRECTLY (as ExecStart does below). Do not
#   wrap it in a shell pipeline, `stdbuf`, `tee`, or anything that re-buffers its
#   stdout — that would defeat the unitbuf and logs would only appear in chunks.
#   StandardOutput=journal already gives journald the raw stream.
#
# ---------------------------------------------------------------------------
# Configuration — EnvironmentFile, and the ${VAR} vs $VAR split
#   Every setting is an environment variable in /etc/eden/instances/<name>.conf
#   (copy it from ops/edenserver.conf.example and edit EDEN_WORLD_DIR,
#   EDEN_PORT, EDEN_NAME, etc. for this instance). `EnvironmentFile=-/etc/eden/instances/%i.conf`
#   (leading `-`) means a missing file is not a startup failure, so this template
#   still works before anyone creates the config — but ExecStart then expands
#   the required keys to empty and the server exits with a flag error in the
#   journal. Create the file.
#
#   ExecStart below uses BRACED ${VAR} for the five always-set keys (one argument
#   each, spaces preserved) and BARE $EDEN_EXTRA_ARGS once, for a whitespace-split
#   tail of optional spaceless flags. An unset braced ${VAR} still passes an
#   empty argument, so anything optional-and-possibly-spaced must live in
#   EDEN_EXTRA_ARGS, never as its own ${VAR}. The conf file header explains this
#   at length; do not "tidy" ExecStart by turning EDEN_EXTRA_ARGS into ${...}.
#
# ---------------------------------------------------------------------------
# Restart policy — why NOT Restart=always
#   --idle-timeout makes the server exit(0) *cleanly* once it has had no players
#   for N seconds (for on-demand / matchmaker-spawned worlds). systemd's
#   Restart=always restarts a unit on ANY exit, clean or not — so pairing it with
#   --idle-timeout produces a restart loop: start, sit idle, exit(0), restart,
#   sit idle, exit(0)... forever, hammering the CPU and the journal.
#   Restart=on-failure only restarts on a non-zero exit / signal, so a crash is
#   recovered but a deliberate idle exit is respected. This unit does not pass
#   --idle-timeout (an always-on server wants to stay up); if you add it, keep
#   Restart=on-failure. If you switch to Restart=always, remove --idle-timeout.
# ---------------------------------------------------------------------------

[Unit]
Description=Eden world-backend server (%i)
Documentation=https://github.com/hagg3/ewb-server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# Dedicated unprivileged user — see ops/INSTALL.md for `useradd`.
User=edenserver
Group=edenserver

# The state root for this instance. Every world file is addressed absolutely
# off ${EDEN_WORLD_DIR} in ExecStart, so CWD is only a fallback; it must still
# be a directory the service user can reach.
WorkingDirectory=/var/lib/edenserver/worlds/%i

# Per-instance settings from /etc/eden/instances/<name>.conf. `-` => a missing file
# is tolerated (the server then errors on the empty flags, visibly, in the journal).
EnvironmentFile=-/etc/eden/instances/%i.conf

# Braced ${VAR} for the always-set keys; bare $EDEN_EXTRA_ARGS for the optional
# spaceless tail. Edit /etc/eden/instances/%i.conf, not this line. See the conf
# header and the note block above for why the split matters.
ExecStart=/usr/local/bin/edenserver --port ${EDEN_PORT} --name ${EDEN_NAME} --world ${EDEN_WORLD_DIR}/eden_world.model --signs ${EDEN_WORLD_DIR}/eden_signs.txt --spawn-file ${EDEN_WORLD_DIR}/eden_spawn.txt --motd-file ${EDEN_WORLD_DIR}/eden_motd.txt --ban-file ${EDEN_WORLD_DIR}/eden_bans.txt --ops-file ${EDEN_WORLD_DIR}/eden_ops.txt --control-socket ${EDEN_WORLD_DIR}/edenserver.sock --max-world-cells ${EDEN_MAX_WORLD_CELLS} --password ${EDEN_PASSWORD} $EDEN_EXTRA_ARGS

Restart=on-failure
RestartSec=2s

# Give a graceful stop room to finish. `systemctl stop` sends SIGTERM, which the
# server now handles (stage 7.9): it saves the world/positions/signs and gives
# every connected client's writer up to SV_CLOSE_DRAIN_SEC to drain before
# exiting. This is that window, with slack.
TimeoutStopSec=20

# Live logs to the journal: journalctl -u edenserver@<name> -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=edenserver-%i

# --- Sandboxing (defence in depth; the server is network-facing) ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# The only path the service may write to:
ReadWritePaths=/var/lib/edenserver
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
